# Copy this file to .env.local for local runs, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Nifty personal API token: Nifty → Settings → API Tokens → New token.
# Scopes needed (read only): tasks:read, statuses:read, lists:read
NIFTY_TOKEN=

# The LEDGERS.cloud project in Nifty.
NIFTY_PROJECT_ID=yb6vQ7M!g0
