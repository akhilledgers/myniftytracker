# Copy this file to .env.local for local runs, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Nifty personal API token: Nifty → Settings → API Tokens → New token.
# Viewing needs:  tasks:read, statuses:read, lists:read, members:read, custom-fields:read, messages:read
# Editing needs:  tasks:write, messages:write
NIFTY_TOKEN=

# The LEDGERS.cloud project in Nifty.
NIFTY_PROJECT_ID=yb6vQ7M!g0

# Secret that unlocks editing and comments in the dashboard (any long random text).
# Without it the dashboard is read-only.
EDIT_KEY=

# Morning email (weekdays, around 9:30 IST). Resend: https://resend.com → API Keys.
RESEND_API_KEY=
# Who receives it, comma separated.
DIGEST_TO=
# Sender. Leave empty to use Resend's test sender, which can only send to the
# address you signed up to Resend with. Verify your domain in Resend to send to others,
# then use e.g. "LEDGERS Pulse <pulse@ledgers.cloud>".
DIGEST_FROM=
# Any long random text. Vercel uses it to call the digest on schedule.
CRON_SECRET=
